{
  "schemaVersion": 1,
  "id": "folia-lyrics-skin",
  "name": "Folia 歌词皮肤",
  "version": "1.0.0",
  "format": "echomod",
  "kind": "qml-js",
  "entry": "entry.mjs",
  "description": "Folia 原生歌词页面，在页面内选择歌词样式。",
  "author": "EchoMusic contributors; Folia by chthollyphile and contributors",
  "license": "AGPL-3.0-only",
  "requires": {
    "hostVersion": ">=0.1.0 <1.0.0",
    "sdkVersion": ">=1.0.0 <2.0.0",
    "features": [
      "lifecycle",
      "ui.lyricsPage",
      "ui.state",
      "ui.presentationClosing",
      "ui.presentationVisibility",
      "playback.context",
      "playback.lyrics",
      "playback.lyrics.metadata",
      "playback.transitionPresentation",
      "appearance.snapshot",
      "appearance.metadata",
      "appearance.lyricIcons",
      "appearance.fonts",
      "audio.spectrum",
      "assets.images",
      "assets.imageBatches",
      "assets.imageDrops",
      "assets.fonts",
      "assets.sampleImage",
      "assets.sourceDimensions",
      "assets.animation",
      "assets.staticSvg",
      "assets.imageArchives",
      "text.segmentation",
      "text.glyphs",
      "graphics.floatTexture",
      "graphics.glyphRun.canvas",
      "graphics.pointMesh",
      "graphics.shaderComposition",
      "graphics.imageCapture",
      "graphics.rhi"
    ]
  },
  "capabilities": ["lyricsPage", "audioSpectrum", "graphics"],
  "contexts": ["main"]
}
