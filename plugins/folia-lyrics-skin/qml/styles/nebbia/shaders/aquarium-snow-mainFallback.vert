layout(std140,binding=0) uniform NativeFrame { vec4 nativeViewport; vec4 nativeOutput; mat4 nativeCorrection; };
layout(std140,binding=1) uniform NebbiaUniforms {
  vec2 uRes;
  vec2 uSceneShift;
  float uTime;
  float uBus;
  float uNeon;
  vec3 uSky0;
  vec3 uSky1;
  vec3 uLa;
  vec3 uLb;
  vec3 uLc;
  vec2 uSpotSrc;
  vec2 uSpotSrc2;
  vec2 uSpotTgt;
  float uSpotR;
  float uSpotI;
  int uScenery;
  bvec3 uBldOn;
  vec3 uBldGeo[3];
  vec4 uJelly[24];
  vec4 uJellyC[24];
  int uJellyN;
  float uBubbles;
  vec4 uBurst[12];
  int uBurstN;
  float uBeatRows;
  vec4 uSway;
  float uWeedIdle;
  float uDewGlint;
  bool uBreathOn;
  float uBreathThick;
  vec2 uGlassShift;
