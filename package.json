{
  "name": "echomusicnext-plugins",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "echo-plugin build-index",
    "check": "echo-plugin check-index && echo-plugin check-sdk && tsc -p tsconfig.json && npm run format:check",
    "test": "node --test tests/*.test.mjs",
    "sdk:sync": "echo-plugin sdk-sync",
    "sdk:check": "echo-plugin check-sdk",
    "test:host": "echo-plugin test-host",
    "format:write": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare:source": "echo-plugin prepare-index",
    "check:published": "echo-plugin check-published",
    "check:published:official": "echo-plugin check-published --scope official",
    "check:published:third-party": "echo-plugin check-published --scope third-party",
    "build:folia": "echo-plugin build plugins/folia-lyrics-skin --out dist"
  },
  "devDependencies": {
    "@echomusicnext/plugin-sdk": "1.0.0",
    "@echomusicnext/plugin-tools": "1.0.0",
    "pngjs": "7.0.0",
    "prettier": "3.9.10",
    "three": "0.185.1"
  }
}
